{
  "$meta": {
    "name": "I Do Enterprise Design Tokens",
    "source": "DESIGN_SYSTEM.md — extracted from homepage reference",
    "direction": "rtl",
    "note": "Hex/size values sampled visually; reconcile with brand/Figma source before locking."
  },
  "color": {
    "primary": {
      "base":  { "value": "#1E50C8", "use": "Primary buttons, links, key icons" },
      "hover": { "value": "#1A45AD", "use": "Button hover/pressed" },
      "accent":{ "value": "#2C7BE5", "use": "Highlighted heading word, bright accents" },
      "50":    { "value": "#EAF1FF", "use": "Eyebrow badge, light icon bg" },
      "100":   { "value": "#DCE8FF", "use": "Hover tints, chips" }
    },
    "navy": {
      "900":     { "value": "#0C1A38", "use": "Footer/final CTA base" },
      "800":     { "value": "#14264C", "use": "Dark gradient top" },
      "heading": { "value": "#1A2A4A", "use": "Default heading color" }
    },
    "text": {
      "body":   { "value": "#3F4A60", "use": "Body text on light bg" },
      "muted":  { "value": "#6B7588", "use": "Subtitles, descriptions" },
      "subtle": { "value": "#94A3B8", "use": "Meta, placeholder, disabled" }
    },
    "border": { "value": "#E6EAF2", "use": "Hairline dividers, subtle edges" },
    "surface": {
      "page": { "value": "#FFFFFF" },
      "tint": { "value": "#F4F6FE", "use": "Alternating section bg" },
      "card": { "value": "#FFFFFF" }
    },
    "status": {
      "success": { "value": "#1FA45C", "bg": "#E4F6EC", "use": "Completed, positive delta" },
      "warning": { "value": "#B0822E", "bg": "#F7EEDD", "use": "Pending/on-hold" },
      "danger":  { "value": "#DC2F36", "bg": "#FBE7E8", "use": "Problem, overdue" },
      "info":    { "value": "#1E50C8", "bg": "#E6EDFB", "use": "In progress, solution" }
    },
    "category": {
      "accounting":   { "from": "#8B6DF0", "to": "#6D4FE0" },
      "realEstate":   { "from": "#F5A24A", "to": "#ED8636" },
      "assets":       { "from": "#3B82F6", "to": "#1E50C8" },
      "maintenance":  { "from": "#8A93A6", "to": "#5C6477" },
      "cleaning":     { "from": "#34C27E", "to": "#1FA45C" },
      "medical":      { "from": "#F26D6D", "to": "#E04848" },
      "government":   { "from": "#D9A441", "to": "#C08A2E" },
      "universities": { "from": "#9A7DFD", "to": "#7C5CFC" }
    },
    "gradient": {
      "hero":  "linear-gradient(180deg, #6FA8E6 0%, #3E73CF 55%, #EAF2FC 100%)",
      "blue":  "linear-gradient(135deg, #3E78D8 0%, #2C5FBF 100%)",
      "dark":  "linear-gradient(160deg, #14264C 0%, #0C1A38 100%)"
    }
  },
  "typography": {
    "fontFamily": {
      "arabic": "Tajawal, Cairo, 'IBM Plex Sans Arabic', system-ui, sans-serif",
      "latin":  "Inter, 'IBM Plex Sans', system-ui, sans-serif"
    },
    "weight": { "regular": 400, "medium": 500, "bold": 700, "black": 800 },
    "scaleDesktop": {
      "display": { "size": "52px", "weight": 800, "lineHeight": 1.35 },
      "h2":      { "size": "40px", "weight": 800, "lineHeight": 1.4 },
      "h3":      { "size": "22px", "weight": 700, "lineHeight": 1.4 },
      "lead":    { "size": "18px", "weight": 400, "lineHeight": 1.8 },
      "body":    { "size": "16px", "weight": 400, "lineHeight": 1.8 },
      "small":   { "size": "14px", "weight": 400, "lineHeight": 1.6 },
      "eyebrow": { "size": "14px", "weight": 600, "lineHeight": 1 },
      "stat":    { "size": "36px", "weight": 800, "lineHeight": 1.1 }
    },
    "scaleMobile": {
      "display": "34px",
      "h2": "28px",
      "stat": "28px"
    },
    "numerals": "western"
  },
  "spacing": {
    "base": "4px",
    "scale": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px", "30": "120px" },
    "sectionPaddingDesktop": "96px–120px",
    "sectionPaddingMobile": "64px",
    "cardPadding": "24px–32px",
    "gridGap": "24px",
    "contentToCta": "48px–64px"
  },
  "layout": {
    "containerMax": "1280px",
    "containerGutter": "24px",
    "columns": 12,
    "gridGap": "24px",
    "columnCounts": {
      "heroFeatures": { "desktop": 3, "tablet": 3, "mobile": 1 },
      "modules":      { "desktop": 5, "tablet": 3, "mobile": 1 },
      "steps":        { "desktop": 4, "tablet": 2, "mobile": 1 },
      "stories":      { "desktop": 1, "tablet": 1, "mobile": 1 },
      "sectors":      { "desktop": 4, "tablet": 2, "mobile": 1 },
      "footer":       { "desktop": 4, "tablet": 2, "mobile": 1 }
    }
  },
  "radius": {
    "pill": "999px",
    "icon": "16px",
    "card": "20px",
    "panel": "36px"
  },
  "shadow": {
    "sm":  "0 2px 8px rgba(30,80,200,0.06)",
    "md":  "0 8px 24px rgba(30,80,200,0.10)",
    "lg":  "0 18px 48px rgba(20,40,80,0.14)",
    "glow":"0 0 40px rgba(60,120,230,0.45)"
  },
  "motion": {
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "duration": { "fast": "150ms", "base": "200ms", "slow": "250ms" }
  }
}
